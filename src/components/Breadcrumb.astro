---
interface CrumbOption {
  href: string;
  label: string;
}

interface Crumb {
  href?: string;
  label: string;
  /** 現在地をセレクトで同階層の他項目へ移動させるとき */
  options?: CrumbOption[];
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="パンくず">
  <ol>
    {
      items.map((item) => (
        <li>
          {item.options && item.options.length > 0 ? (
            <select
              class="breadcrumb-jump__select"
              aria-label="他の問題へ移動"
              onchange="if (this.value) window.location.href = this.value"
            >
              {item.options.map((option) => (
                <option value={option.href} selected={option.label === item.label}>
                  {option.label}
                </option>
              ))}
            </select>
          ) : item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    row-gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .breadcrumb li {
    display: inline;
  }

  .breadcrumb li:not(:last-child)::after {
    content: ' > ';
    color: var(--border);
    white-space: pre;
  }

  .breadcrumb a,
  .breadcrumb span {
    color: var(--ink-muted);
    text-decoration: none;
    line-height: inherit;
    vertical-align: baseline;
  }

  .breadcrumb a:hover {
    color: var(--link);
  }

  .breadcrumb-jump__select {
    appearance: none;
    font: inherit;
    line-height: inherit;
    color: var(--ink);
    background-color: transparent;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
      linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 0.75rem) 55%,
      calc(100% - 0.45rem) 55%;
    background-size: 0.3rem 0.3rem, 0.3rem 0.3rem;
    background-repeat: no-repeat;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.1rem 1.4rem 0.1rem 0.45rem;
    max-width: 100%;
    cursor: pointer;
    vertical-align: baseline;
  }

  .breadcrumb-jump__select:hover,
  .breadcrumb-jump__select:focus-visible {
    border-color: var(--link);
    outline: none;
  }

  @media (max-width: 640px) {
    .breadcrumb ol {
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
  }
</style>
