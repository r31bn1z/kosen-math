---
interface Props {
  prevHref?: string | null;
  prevLabel?: string | null;
  nextHref?: string | null;
  nextLabel?: string | null;
}

const { prevHref, prevLabel, nextHref, nextLabel } = Astro.props;
---

<nav class="prev-next" aria-label="前後の問題">
  <div>
    {
      prevHref && prevLabel ? (
        <a href={prevHref}>← {prevLabel}</a>
      ) : (
        <span />
      )
    }
  </div>
  <div class="next">
    {
      nextHref && nextLabel ? (
        <a href={nextHref}>{nextLabel} →</a>
      ) : (
        <span />
      )
    }
  </div>
</nav>

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1rem;
    align-items: start;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .prev-next > * {
    min-width: 0;
  }

  .prev-next a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .next {
    text-align: right;
  }

  @media (max-width: 640px) {
    .prev-next {
      margin-top: 2rem;
      font-size: 0.9rem;
    }
  }
</style>
