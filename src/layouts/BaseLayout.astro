---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import {
  DEFAULT_DESCRIPTION,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  SITE_NAME,
  assetUrl,
  canonicalUrl,
  pageTitle as formatTitle,
  stringifyJsonLd,
  type JsonLd,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLd | JsonLd[];
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = formatTitle(title);
const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = assetUrl(OG_IMAGE_PATH);
const jsonLdBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f7f4ef" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    {
      jsonLdBlocks.map((block) => (
        <script is:inline type="application/ld+json" set:html={stringifyJsonLd(block)} />
      ))
    }
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/">高専の数学解説</a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="メニューを開く"
      >
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="サイト">
        <a href="/about/">このサイトについて</a>
        <a href="/developer/">開発者について</a>
        <a href="/disclaimer/">免責事項</a>
      </nav>
    </header>
    <button class="nav-backdrop" type="button" aria-label="メニューを閉じる" tabindex="-1"></button>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('#site-nav');
      const backdrop = document.querySelector('.nav-backdrop');
      if (
        toggle instanceof HTMLButtonElement &&
        nav instanceof HTMLElement &&
        backdrop instanceof HTMLButtonElement
      ) {
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
          document.body.classList.toggle('nav-open', open);
          backdrop.tabIndex = open ? 0 : -1;
        };

        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          setOpen(open);
        });

        backdrop.addEventListener('click', () => setOpen(false));

        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });

        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="site-footer__meta">
        <span>&copy; {new Date().getFullYear()} r31bn1z</span>
        <span class="site-footer__sep" aria-hidden="true">·</span>
        <span>Created with <a href="https://astro.build/" rel="noopener noreferrer">Astro</a></span>
      </p>
    </footer>
  </body>
</html>
