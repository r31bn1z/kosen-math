---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import PrevNext from '../../../components/PrevNext.astro';
import { getCatalog, getChapterProblems } from '../../../lib/catalog';
import { neighbors, problemHref } from '../../../lib/math1';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  const paths = [];
  for (const chapter of catalog.chapters) {
    const problems = getChapterProblems(catalog, chapter.id);
    for (const problem of problems) {
      paths.push({
        params: {
          chapter: chapter.id,
          problem: problem.problem,
        },
        props: { chapter, problem, problems },
      });
    }
  }
  return paths;
}

const { chapter, problem, problems } = Astro.props;
const { Content } = await render(problem.entry);
const { prev, next } = neighbors(problems, problem.problem);
const heading = `${chapter.title} ${problem.title}`;
---

<BaseLayout title={heading} description={`${heading}の解説`}>
  <Breadcrumb
    items={[
      { href: '/1/', label: '高専の数学1' },
      { href: `/1/${chapter.id}/`, label: chapter.title },
      {
        label: problem.title,
        options: problems.map((item) => ({
          href: problemHref(item.chapter, item.problem),
          label: item.title,
        })),
      },
    ]}
  />
  <h1>{heading}</h1>
  <article class="prose">
    <Content />
  </article>
  <PrevNext
    prevHref={prev ? problemHref(prev.chapter, prev.problem) : null}
    prevLabel={prev?.title ?? null}
    nextHref={next ? problemHref(next.chapter, next.problem) : null}
    nextLabel={next?.title ?? null}
  />
</BaseLayout>
