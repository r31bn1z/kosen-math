---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCatalog, getChapterProblems } from '../../../lib/catalog';
import { problemHref } from '../../../lib/math1';
import { breadcrumbJsonLd, chapterDescription, collectionPageJsonLd } from '../../../lib/seo';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.chapters.map((chapter) => ({
    params: { chapter: chapter.id },
    props: {
      chapter,
      problems: getChapterProblems(catalog, chapter.id),
    },
  }));
}

const { chapter, problems } = Astro.props;
const description = chapterDescription(chapter.title);
const chapterPath = `/1/${chapter.id}/`;
---

<BaseLayout
  title={chapter.title}
  description={description}
  jsonLd={[
    collectionPageJsonLd(chapter.title, chapterPath, description),
    breadcrumbJsonLd([
      { name: '高専の数学解説', path: '/' },
      { name: '高専の数学1', path: '/1/' },
      { name: chapter.title },
    ]),
  ]}
>
  <Breadcrumb
    items={[
      { href: '/1/', label: '高専の数学1' },
      { label: chapter.title },
    ]}
  />
  <h1>{chapter.title}</h1>
  <ul>
    {
      problems.map((problem) => (
        <li>
          <a href={problemHref(problem.chapter, problem.problem)}>{problem.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
