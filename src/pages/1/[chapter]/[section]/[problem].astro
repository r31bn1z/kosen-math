---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import TextbookNote from '../../../../components/TextbookNote.astro';
import PrevNext from '../../../../components/PrevNext.astro';
import { getCatalog, getSectionProblems } from '../../../../lib/catalog';
import { neighbors, problemHref } from '../../../../lib/math1';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  const paths = [];
  for (const chapter of catalog.chapters) {
    for (const section of catalog.sectionsByChapter[chapter.id] ?? []) {
      const problems = getSectionProblems(catalog, chapter.id, section.id);
      for (const problem of problems) {
        paths.push({
          params: {
            chapter: chapter.id,
            section: section.id,
            problem: problem.problem,
          },
          props: { chapter, section, problem, problems },
        });
      }
    }
  }
  return paths;
}

const { chapter, section, problem, problems } = Astro.props;
const { Content } = await render(problem.entry);
const { prev, next } = neighbors(problems, problem.problem);
const heading = `${chapter.title} ${section.title} ${problem.title}`;
---

<BaseLayout title={heading} description={`${heading}の解説`}>
  <Breadcrumb
    items={[
      { href: '/1/', label: '1年' },
      { href: `/1/${chapter.id}/`, label: chapter.title },
      { href: `/1/${chapter.id}/${section.id}/`, label: section.title },
      { label: problem.title },
    ]}
  />
  <h1>{heading}</h1>
  <TextbookNote />
  <article class="prose">
    <Content />
  </article>
  <PrevNext
    prevHref={prev ? problemHref(prev.chapter, prev.section, prev.problem) : null}
    prevLabel={prev?.title ?? null}
    nextHref={next ? problemHref(next.chapter, next.section, next.problem) : null}
    nextLabel={next?.title ?? null}
  />
</BaseLayout>
