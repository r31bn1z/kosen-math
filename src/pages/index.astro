---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCatalog, getChapterProblems } from '../lib/catalog';
import { problemHref } from '../lib/math1';
import { DEFAULT_DESCRIPTION, websiteJsonLd } from '../lib/seo';

const catalog = await getCatalog();
---

<BaseLayout title="高専の数学解説" description={DEFAULT_DESCRIPTION} jsonLd={websiteJsonLd()}>
  <h1>高専の数学解説</h1>
  <p class="lede">『高専の数学1』に準拠した独自解説をまとめています。問題文は掲載せず、章・問番号で指します。</p>

  <ul class="year-list">
    <li>
      <details class="year-panel">
        <summary>
          <a class="year-panel__title" href="/1/">高専の数学1</a>
        </summary>
        <div class="year-panel__body">
          {
            catalog.chapters.length === 0 ? (
              <p class="year-panel__empty">公開中の解説はまだありません。</p>
            ) : (
              <ul class="toc-chapters">
                {catalog.chapters.map((chapter) => (
                  <li>
                    <details>
                      <summary>
                        <a class="toc-chapter__title" href={`/1/${chapter.id}/`}>
                          {chapter.title}
                        </a>
                      </summary>
                      <ul class="toc-problems">
                        {getChapterProblems(catalog, chapter.id).map((problem) => (
                          <li>
                            <a href={problemHref(problem.chapter, problem.problem)}>
                              {problem.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </details>
    </li>

    <li>
      <details class="year-panel">
        <summary>
          <a class="year-panel__title" href="/2/">高専の数学2</a>
        </summary>
        <div class="year-panel__body">
          <p class="year-panel__empty">準備中です。</p>
        </div>
      </details>
    </li>

    <li>
      <details class="year-panel">
        <summary>
          <a class="year-panel__title" href="/3/">高専の数学3</a>
        </summary>
        <div class="year-panel__body">
          <p class="year-panel__empty">準備中です。</p>
        </div>
      </details>
    </li>
  </ul>

  <script>
    document
      .querySelectorAll('.year-panel > summary a, .toc-chapters > li > details > summary a')
      .forEach((link) => {
        link.addEventListener('click', (event) => {
          event.stopPropagation();
        });
      });
  </script>
</BaseLayout>
